{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclaw-repos-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "routes": [
    {
      "pattern": "glaubi.net/openclaw",
      "zone_name": "glaubi.net"
    },
    {
      "pattern": "glaubi.net/openclaw/*",
      "zone_name": "glaubi.net"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
